# Public Supabase connection values. The publishable key is intentionally
# public and is protected by PostgreSQL Row Level Security.
# Never add a secret/service-role key to a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Supabase secret key (sb_secret_...). Required for private profile
# photo Storage operations. Never prefix this variable with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=your-server-only-secret-key

# Used to build email verification and password-reset callback URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
